{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Agent",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/invoices": {
      "get": {
        "summary": "List Invoices",
        "description": "The queue: every invoice, newest first, with how its review turned out.",
        "operationId": "list_invoices_invoices_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InvoiceSummary"
                  },
                  "type": "array",
                  "title": "Response List Invoices Invoices Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Invoice",
        "description": "Accept an invoice PDF and queue it for review.\n\nReturns as soon as the row exists: a review takes 30-60s, longer than a\nclient will hold a connection open. The id handed back is what the dashboard\nthen polls.",
        "operationId": "create_invoice_invoices_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_invoice_invoices_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}": {
      "get": {
        "summary": "Get Invoice",
        "description": "One invoice, with the whole transcript of how it was decided.\n\nAn invoice with no run yet is a 200 with an empty transcript, not a 404: the\nrow exists from upload, and this is where its review is watched happening.",
        "operationId": "get_invoice_invoices__invoice_id__get",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Invoice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}/file": {
      "get": {
        "summary": "Get Invoice File",
        "description": "The invoice's own PDF, for the upload-time preview.\n\nServed straight from `raw_pdf_path`, so what a reviewer sees is provably the\nsame bytes extraction ran against.",
        "operationId": "get_invoice_file_invoices__invoice_id__file_get",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Invoice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}/activity": {
      "get": {
        "summary": "Get Activity",
        "description": "What the agent is doing right now.\n\nPolled about once a second, so it answers with the one call that changed\nrather than the transcript it belongs to. Outputs are left out of `latest`\nfor the same reason: the ticker only renders the tool name and its input.",
        "operationId": "get_activity_invoices__invoice_id__activity_get",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Invoice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Activity"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}/approve": {
      "post": {
        "summary": "Approve Invoice",
        "description": "Clear an invoice for payment by human decision.",
        "operationId": "approve_invoice_invoices__invoice_id__approve_post",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Invoice Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/DecisionNote"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/invoices/{invoice_id}/reject": {
      "post": {
        "summary": "Reject Invoice",
        "description": "Refuse an invoice. Records the decision; nothing downstream acts on it.",
        "operationId": "reject_invoice_invoices__invoice_id__reject_post",
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Invoice Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/DecisionNote"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvoiceSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit-log": {
      "get": {
        "summary": "List Audit Log",
        "description": "Every human decision, newest first.\n\n`before_state`/`after_state` carry the agent's decision and confidence at\nthat moment, so a reviewer can see what they overrode as well as their own\nreasoning for it.",
        "operationId": "list_audit_log_audit_log_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuditEntry"
                  },
                  "type": "array",
                  "title": "Response List Audit Log Audit Log Get"
                }
              }
            }
          }
        }
      }
    },
    "/vendors/pending": {
      "get": {
        "summary": "List Pending Vendors",
        "description": "Drafted payees waiting on a person to check them out of band.",
        "operationId": "list_pending_vendors_vendors_pending_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PendingVendor"
                  },
                  "type": "array",
                  "title": "Response List Pending Vendors Vendors Pending Get"
                }
              }
            }
          }
        }
      }
    },
    "/vendors/{vendor_id}/approve": {
      "post": {
        "summary": "Approve Vendor",
        "description": "Make a drafted payee payable, once a human has approved them.\n\nWhen the agent meets an unknown payee it drafts a vendor, but a drafted\nvendor is not payable and the agent cannot change that. This endpoint is\nwhere a person, having checked the payee out of band, marks them active --\nand being active is what lets them be paid against at all.",
        "operationId": "approve_vendor_vendors__vendor_id__approve_post",
        "parameters": [
          {
            "name": "vendor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Vendor Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VendorApproved"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
